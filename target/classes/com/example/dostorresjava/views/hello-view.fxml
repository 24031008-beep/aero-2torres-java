<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dostorresjava.controllers.LoginController"
            prefHeight="400.0" prefWidth="600.0">
    <top >
        <VBox alignment="BASELINE_CENTER">
            <Label text="Inicie sesión o registrese" style="-fx-font-size: 20.0; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="10.0" top="20.0"/>
            </padding>
            <Label text="Inserte su correo de usuario"/>
            <TextField fx:id="txtCorreo" VBox.vgrow="ALWAYS" promptText="Tu correo"/>
            <Label text="Inserte su contraseña"/>
            <PasswordField fx:id="txtPassword" VBox.vgrow="ALWAYS" promptText="Tu contraseña"/>
            <HBox spacing="10.0" alignment="BASELINE_CENTER">
                <Button fx:id="btnEntrar" text="Iniciar Sesión" onAction="#onLooginButtonClick"
                        style="-fx-background-color: #333333; -fx-text-fill: white; -fx-font-family: 'Microsoft JhengHei'"/>
                <Button text="Registrate" onAction="#onAddButtonClick"
                        style="-fx-background-color: #333333; -fx-text-fill: white; -fx-font-family: 'Microsoft JhengHei'"/>
            </HBox>
            <Label fx:id="lblMensaje"/>

        </VBox>
    </center>
</BorderPane>